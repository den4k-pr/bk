 }
+
+// ─── Нормалізація тексту картки перекладу ───────────────────────────────
+// Старі записи словника приходять із "сміттям" після давніх прогонів
+// парсингу: пробіли по краях, подвійні / нерозривні пробіли, переноси
+// рядків, невидимі символи (м'який перенос, zero-width), пробіли перед
+// розділовими знаками і "розірвані" дефіси ("віз -аут"). Нові записи вже
+// чисті — для них ця функція нічого не змінює.
+
+// М'який перенос, пробіли нульової ширини, маркери напрямку, BOM.
+const INVISIBLE_CHARS = /[\u00AD\u200B-\u200F\u202A-\u202E\u2060-\u2064\uFEFF]/g;
+// Нерозривні та "тонкі" пробіли, табуляції, переноси рядків → звичайний пробіл.
+const ODD_WHITESPACE = /[\u00A0\u2007\u202F\t\r\n\f\v]+/g;
+// Типографські апострофи → один вигляд (don’t / don't / donʼt).
+const APOSTROPHES = /[’‘ʼ`´]/g;
+// Літера (латиниця + кирилиця) — без \p{L}, щоб не залежати від підтримки
+// Unicode property escapes у версії Hermes.
+const LETTER = "[A-Za-zА-Яа-яЁёІіЇїЄєҐґ']";
+
+export function normalizeCardText(raw: unknown): string {
+  if (typeof raw !== 'string') return '';
+  return raw
+    .replace(INVISIBLE_CHARS, '')
+    .replace(ODD_WHITESPACE, ' ')
+    .replace(APOSTROPHES, "'")
+    // "віз -аут" / "віз- аут" → "віз-аут" (дефіс усередині слова). Тире з
+    // пробілами з обох боків (" - ") — це роздільник, його не чіпаємо.
+    .replace(new RegExp(`(${LETTER})\\s+-(?=${LETTER})`, 'g'), '$1-')
+    .replace(new RegExp(`(${LETTER})-\\s+(?=${LETTER})`, 'g'), '$1-')
+    // Пробіли перед розділовими знаками та всередині дужок.
+    .replace(/\s+([,.;:!?…)\]])/g, '$1')
+    .replace(/([(\[])\s+/g, '$1')
+    // Подвійні (і більше) пробіли всередині → один.
+    .replace(/\s{2,}/g, ' ')
+    .trim();
+}
+
+/** Кількість слів у вже нормалізованому тексті (порожній рядок → 0). */
+export function countCardWords(normalized: string): number {
+  return normalized ? normalized.split(' ').filter(Boolean).length : 0;
+}
+
+// Правило довгої фрази: понад 3 слова → шрифт на 20% менший. Інших
+// адаптацій розміру немає — лише ці два фіксовані значення.
+export const LONG_PHRASE_MIN_WORDS = 4;
+export const LONG_PHRASE_FONT_SCALE = 0.8;
+
+export function cardWordFontSize(baseFontSize: number, normalizedText: string): number {
+  return countCardWords(normalizedText) >= LONG_PHRASE_MIN_WORDS
+    ? Math.round(baseFontSize * LONG_PHRASE_FONT_SCALE)
+    : baseFontSize;
+}
